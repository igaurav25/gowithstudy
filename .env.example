# ==============================================================================
# GoWithStudy — Local, Docker & Production Environment Template
# ==============================================================================
# Copy this file to '.env.local' for local development or '.env' for docker-compose / production.
# NEVER commit real credentials or secrets to Git!
# ==============================================================================

# --- Application Runtime ---
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admission & Verification Feature Flags ---
# Set to 'true' in production to disable self-service signups and enforce admission review
NEXT_PUBLIC_DISABLE_PUBLIC_SIGNUP="true"
VERIFICATION_WORKFLOW_ENABLED="true"

# --- Database (PostgreSQL) ---
# For local machine running Postgres natively on 5432:
DATABASE_URL="postgresql://postgres:password@localhost:5432/gowithstudy?schema=public"

# For docker-compose.yml:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=gowithstudy_secure_password
POSTGRES_DB=gowithstudy

# --- Authentication & Session Security ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="gowithstudy-super-secure-dev-session-key-32chars"
SESSION_COOKIE_NAME="gws_session"
EMAIL_TOKEN_EXPIRY_SECONDS=86400

# --- Super Admin Security & AES-256 Encryption ---
# 32-byte key used to encrypt TOTP secrets at rest in AES-256-GCM.
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ADMIN_SECRET_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# --- One-Time Super Admin Provisioning & Recovery ---
# Set ADMIN_SETUP_TOKEN to enable one-time /setup-admin. Remove after setup and redeploy.
# ADMIN_SETUP_TOKEN=""
# Set ADMIN_RECOVERY_TOKEN to enable /recover-admin emergency recovery. Remove/rotate after use.
# ADMIN_RECOVERY_TOKEN=""

# --- Admin Authentication Fallbacks (Default off) ---
ADMIN_EMAIL_OTP_FALLBACK="false"
ADMIN_SMS_OTP="false"

# --- Hosted Redis / Upstash Cache ---
# For local Redis container:
REDIS_URL="redis://localhost:6379"

# For Vercel Serverless Production (Upstash Redis REST API):
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# --- Bot Protection (Cloudflare Turnstile) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# --- AI Provider Configuration ---
AI_PROVIDER="local" # Options: "local", "gemini"
GEMINI_API_KEY=""

# --- Live Web Search Engine Configuration (Optional: DuckDuckGo is used automatically by default) ---
TAVILY_API_KEY=""
SERPER_API_KEY=""
