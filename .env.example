# CampusFlow Environment Variables Template
# Copy this file to .env.local for local development. NEVER commit real secrets to Git.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/campusflow?schema=public"

# Authentication & Session Security
AUTH_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"
SESSION_COOKIE_NAME="campusflow_session"

# Email Verification & Password Reset (Token Expiry in seconds: e.g., 24h = 86400)
EMAIL_TOKEN_EXPIRY_SECONDS=86400

# AI Provider Configuration (Future Phases)
AI_PROVIDER="local" # Options: "local", "gemini"
GEMINI_API_KEY=""
