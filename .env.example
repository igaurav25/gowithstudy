# ==============================================================================
# CampusFlow — Local & Docker Development Environment Template
# ==============================================================================
# Copy this file to '.env.local' for local development or '.env' for docker-compose.
# NEVER commit real credentials to Git!
# ==============================================================================

# --- Application Runtime ---
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# For local machine running Postgres natively on 5432:
DATABASE_URL="postgresql://postgres:password@localhost:5432/campusflow?schema=public"

# For docker-compose.yml:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=campusflow_secure_password
POSTGRES_DB=campusflow

# --- Authentication & Session Security ---
AUTH_SECRET="campusflow-super-secure-dev-session-key-32chars"
SESSION_COOKIE_NAME="campusflow_session"
EMAIL_TOKEN_EXPIRY_SECONDS=86400

# --- Redis Cache (Optional for dev, included in docker-compose) ---
REDIS_URL="redis://localhost:6379"

# --- AI Provider Configuration ---
AI_PROVIDER="local" # Options: "local", "gemini"
GEMINI_API_KEY=""

# --- Live Web Search Engine Configuration (Optional: DuckDuckGo is used automatically by default) ---
TAVILY_API_KEY=""
SERPER_API_KEY=""

