# ==============================================================================
# CampusFlow — Production Environment Variables Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env.production' on your production server.
# 2. Replace all placeholder values with high-entropy cryptographic secrets.
# 3. Restrict permissions: chmod 600 .env.production
# 4. NEVER commit '.env.production' to version control!
# ==============================================================================

# --- Node Environment ---
NODE_ENV=production
PORT=3000

# --- Domain & Public URL ---
# Set to your fully qualified domain name (used by Caddy SSL and CORS/CSRF headers)
DOMAIN_NAME=campusflow.edu
NEXT_PUBLIC_APP_URL=https://campusflow.edu

# --- PostgreSQL Production Credentials ---
# Note: Generate a strong, random password using: openssl rand -base64 32
POSTGRES_USER=campusflow_admin
POSTGRES_PASSWORD=replace_with_strong_db_password_min_32_chars
POSTGRES_DB=campusflow_production

# Prisma Database Connection String for Docker Network
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public&connection_limit=20&pool_timeout=30

# --- Session & Security Secrets ---
# Generate using: openssl rand -base64 48
AUTH_SECRET=replace_with_super_secret_cryptographic_key_minimum_32_characters
SESSION_COOKIE_NAME=__Host-campusflow_session
EMAIL_TOKEN_EXPIRY_SECONDS=86400

# --- Redis Cache & Session Store ---
# Generate using: openssl rand -hex 24
REDIS_PASSWORD=replace_with_strong_redis_auth_token_here
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# --- AI & External Integrations ---
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_valid_google_gemini_api_key

# --- Rate Limiting & Performance ---
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
